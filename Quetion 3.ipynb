import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import kstest

def sample_mean(x):
    return np.sum(x) / len(x)

def sample_variance(x):
    m = sample_mean(x)
    return np.sum((x - m)**2) / (len(x) - 1)

def sample_skewness(x):
    m = sample_mean(x)
    s = np.sqrt(sample_variance(x))

    return np.mean(((x - m) / s)**3)

def sample_kurtosis_excess(x):
    m = sample_mean(x)
    s = np.sqrt(sample_variance(x))

    return np.mean(((x - m) / s)**4) - 3

